<?xml version="1.0" encoding="utf-8"?>
<!-- 강의자료 p.13 : 네트워크 접근 보안 설정 (로컬 http 서버 접속 허용) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
